{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell(.\\build.ps1 *)",
      "PowerShell(.\\test.ps1 *)",
      "PowerShell(.\\package.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File .\\build.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File .\\test.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File .\\package.ps1 *)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File .\\build.ps1 *)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File .\\test.ps1 *)",
      "PowerShell(.\\build\\test\\tests.exe *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)"
    ],
    "ask": [
      "PowerShell(.\\build\\gputest.exe *)",
      "PowerShell(.\\build\\plugintest.exe *)",
      "Bash(build/gputest.exe *)",
      "Bash(build/plugintest.exe *)",
      "Bash(./build/gputest.exe *)",
      "Bash(./build/plugintest.exe *)",
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(git tag *)",
      "PowerShell(git tag *)"
    ],
    "deny": [
      "PowerShell(.\\install.ps1 *)",
      "PowerShell(.\\uninstall.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File .\\install.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File .\\uninstall.ps1 *)",
      "Bash(powershell -ExecutionPolicy Bypass -File ./install.ps1 *)",
      "Bash(powershell -ExecutionPolicy Bypass -File ./uninstall.ps1 *)",
      "PowerShell(.\\tests\\e2e\\installer.ps1 *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File .\\tests\\e2e\\installer.ps1 *)",
      "Bash(powershell -ExecutionPolicy Bypass -File ./tests/e2e/installer.ps1 *)",
      "PowerShell(.\\dist\\msi-gpu-for-icue-setup-*)",
      "Bash(dist/msi-gpu-for-icue-setup-*)",
      "Bash(./dist/msi-gpu-for-icue-setup-*)"
    ]
  }
}
